import React from 'react';
import { render, screen, fireEvent } from '@testing-library/react';
import { MemoryRouter, Routes, Route } from 'react-router-dom';
import ResumeForm from '../ResumeForm';

// Mock the child components to isolate the ResumeForm logic
jest.mock('../ResumeBasicStep', () => () => <div>ResumeBasicStep</div>);
jest.mock('../ResumeHistoryStep', () => () => <div>ResumeHistoryStep</div>);
jest.mock('../ResumeLicenseStep', () => () => <div>ResumeLicenseStep</div>);
jest.mock('../ResumePRStep', () => () => <div>ResumePRStep</div>);

describe('ResumeForm AI Assistant', () => {
  const renderWithRouter = (ui, { route = '/' } = {}) => {
    window.history.pushState({}, 'Test page', route);
    return render(
      <MemoryRouter initialEntries={[route]}>
        <Routes>
          <Route path="/resume/:step" element={ui} />
        </Routes>
      </MemoryRouter>
    );
  };

  test('should display initial AI message', () => {
    renderWithRouter(<ResumeForm />, { route: '/resume/basic' });
    expect(screen.getByText('こんにちは！履歴書作成をお手伝いします。ご質問やご要望をどうぞ。')).toBeInTheDocument();
  });

  test('should add user message to chat and clear input on send', async () => {
    renderWithRouter(<ResumeForm />, { route: '/resume/basic' });

    const input = screen.getByPlaceholderText('AIに質問・依頼...');
    const sendButton = screen.getByText('送信');

    fireEvent.change(input, { target: { value: 'Hello AI' } });
    expect(input.value).toBe('Hello AI');

    fireEvent.click(sendButton);

    // Check if user message appears
    expect(await screen.findByText('Hello AI')).toBeInTheDocument();
    
    // Check if input is cleared
    expect(input.value).toBe('');
  });

  test('should receive a mock AI response', async () => {
    jest.useFakeTimers();
    renderWithRouter(<ResumeForm />, { route: '/resume/basic' });

    const input = screen.getByPlaceholderText('AIに質問・依頼...');
    const sendButton = screen.getByText('送信');

    fireEvent.change(input, { target: { value: 'Help me with my resume' } });
    fireEvent.click(sendButton);

    // Fast-forward timers
    jest.advanceTimersByTime(700);

    expect(await screen.findByText('（AIのサンプル応答）: Help me with my resume')).toBeInTheDocument();
    jest.useRealTimers();
  });
});